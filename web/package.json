{
  "name": "spotify-review-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview:local": "node scripts/local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/contract.test.ts",
    "test:e2e": "playwright test",
    "scan": "node scripts/scan.mjs",
    "import:snapshot": "node scripts/import-snapshot.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
